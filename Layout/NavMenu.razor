@implements IDisposable
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <span class="bi bi-flower1" aria-hidden="true"></span>
            <span class="brand-text">
                <span class="brand-title">Field Intelligence OS</span>
                <span class="brand-sub">California Agronomy Platform</span>
            </span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dashboard">
                <span class="bi bi-speedometer2" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="fields">
                <span class="bi bi-grid-3x3-gap" aria-hidden="true"></span> Fields
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="entropy">
                <span class="bi bi-cloud-haze2" aria-hidden="true"></span> Entropy
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="gis">
                <span class="bi bi-map" aria-hidden="true"></span> GIS Blocks
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="query">
                <span class="bi bi-chat-square-text" aria-hidden="true"></span> Query
            </NavLink>
        </div>

        <div class="nav-section-label px-3">Learning</div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="learn/boundary-area">
                <span class="bi bi-bounding-box" aria-hidden="true"></span> Boundary &amp; Area
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="learn/terrain-flow">
                <span class="bi bi-water" aria-hidden="true"></span> Terrain Flow
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="learn">
                <span class="bi bi-mortarboard" aria-hidden="true"></span> Learn
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="transfer">
                <span class="bi bi-arrow-left-right" aria-hidden="true"></span> Transfer Hub
            </NavLink>
        </div>

        <div class="nav-section-label px-3">Machine Learning</div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="insights">
                <span class="bi bi-bar-chart-line" aria-hidden="true"></span> Yield Insights
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="optimizer">
                <span class="bi bi-sliders" aria-hidden="true"></span> Input Optimizer
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="benchmark">
                <span class="bi bi-people" aria-hidden="true"></span> Peer Benchmark
            </NavLink>
        </div>

        <div class="nav-section-label px-3">Agronomy Platform</div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="agronomy">
                <span class="bi bi-moisture" aria-hidden="true"></span> Agronomy
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ask">
                <span class="bi bi-chat-dots" aria-hidden="true"></span> Ask
            </NavLink>
        </div>

        <div class="nav-section-label px-3">External Data</div>

        @* Economy (FRED) and Space (NASA) are hidden until their API keys are
           configured — without keys they return 500 / fail CORS on load. *@

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="weather">
                <span class="bi bi-cloud-sun" aria-hidden="true"></span> Weather
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="datasets">
                <span class="bi bi-database" aria-hidden="true"></span> Datasets
            </NavLink>
        </div>

        <div class="nav-section-label px-3">Diagnostics</div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="logs">
                <span class="bi bi-card-list" aria-hidden="true"></span> Logs
            </NavLink>
        </div>
    </nav>

    <div class="sidenav-footer px-3">
        <span class="port-badge">Field :4302</span>
        <span class="port-badge">Weather :4300</span>
        <span class="port-badge">Query :4304</span>
        <span class="port-badge">FRED :4306</span>
        <span class="port-badge">Data.gov :4308</span>
        <span class="port-badge">Agronomy :4310</span>
        <span class="port-badge">AI :4312</span>
        <span class="port-badge">ML :4320</span>
    </div>
</div>

@code {
    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
