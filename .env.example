# Environment variables for the Netlify functions (copy to .env for `netlify dev`).
# .env is gitignored. In production set these under Netlify > Site settings >
# Environment variables.

# CIMIS Web API application key (free): https://cimis.water.ca.gov/
CIMIS_APP_KEY=

# FRED economic data API key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional: override the GAMA groundwater ArcGIS REST layer used for water quality.
# GAMA_ARCGIS_URL=https://.../FeatureServer/0

# No key required: NRCS SDA, CNRA CKAN, Open-Meteo.
# OpenAI/Gemini are NOT required — the AI search service is mocked.
